FROM python:3.11-slim

WORKDIR /app

COPY proto/ ./proto/
COPY backend/ ./backend/

RUN pip install --no-cache-dir fastapi uvicorn[standard] pydantic pydantic-settings sqlalchemy aiosqlite grpcio grpcio-tools httpx aio-pika asyncpg

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
